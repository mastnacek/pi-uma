{
  "name": "@mastnacek/pi-uma",
  "version": "0.2.0",
  "description": "Universal Memory Architecture (UMA) plugin for Pi coding agent with interactive modal approval and VSA architecture",
  "type": "module",
  "main": "index.ts",
  "types": "index.ts",
  "files": [
    "index.ts",
    "src",
    "skills",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "^22.10.0",
    "typebox": "1.3.19",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "syncbin": "node -e \"const fs=require('fs');fs.mkdirSync('bin',{recursive:true});fs.copyFileSync(process.platform==='win32'?'core/target/release/uma.exe':'core/target/release/uma',process.platform==='win32'?'bin/uma.exe':'bin/uma');console.log('bin synced')\""
  },
  "license": "MIT"
}
